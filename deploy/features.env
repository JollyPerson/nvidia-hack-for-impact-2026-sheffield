# Feature flags for the Advolare web app's extras. Loaded by deploy/deploy.sh; see api/README.md.
# true or false. Leave a line commented out to use the default.
# To override on the Spark only, without a commit, put the same lines in ~/trialmatch/features.env.

# Developer mode: feature toggles in every page's footer (on by default while we build).
# Set to false for the judges' demo or any real use.
# ADVOLARE_DEV_MODE=false

# Every extra at once (individual FEATURE_ lines below still win):
# FEATURES_ALL=true

# On by default:
# FEATURE_DO_NOT_CONTACT=true
# FEATURE_DRAFT_CRITERIA=true

# Off by default:
# FEATURE_FAIRNESS=true
# FEATURE_WHAT_IF=true
# FEATURE_SCREENING_LOG=true
# FEATURE_INVITATION_LETTER=true
# FEATURE_FHIR_EXPORT=true
